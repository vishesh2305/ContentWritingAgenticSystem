# Copy to .env and fill in. Never commit .env.

# --- LLM (local Ollama, no API key) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_BULK_MODEL=qwen3-vl:8b-instruct
OLLAMA_WRITING_MODEL=qwen3-vl:8b-instruct
# Same value for every call; changing it makes Ollama reload the model.
OLLAMA_NUM_CTX=32768
OLLAMA_KEEP_ALIVE=30m
# true only with a thinking-capable writing model.
OLLAMA_THINK=false
# Max LLM tokens (prompt + output) per article job; stops runaway loops.
JOB_TOKEN_BUDGET=400000

# --- Research ---
SERPER_API_KEY=
# Optional, for keyword volumes.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Commercial AI detectors (final gate only) ---
# Comma-separated subset of: gptzero,originality,copyleaks
DETECTOR_PANEL=gptzero
# Max AI probability allowed per detector (0-1).
DETECTOR_MAX_AI_PROBABILITY=0.20
GPTZERO_API_KEY=
ORIGINALITY_API_KEY=
COPYLEAKS_EMAIL=
COPYLEAKS_API_KEY=

# --- Infrastructure (matches docker-compose.yml) ---
DATABASE_URL=postgresql://content:content@localhost:5432/content
REDIS_URL=redis://localhost:6379/0
LANGUAGETOOL_URL=http://localhost:8010

# --- Observability (Step 12) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
